{
  "_comment": "bot 的 @名(features.bot_user.display_name)默认 cc,可按喜好改;app 名仍为 slack-bridge。slack-bridge Slack app manifest(plan R2)。在 api.slack.com/apps → Create New App → From an app manifest 粘贴。安装后:bot token(xoxb-)与 app-level token(xapp-,scope connections:write)只经 env/stdin 交给 bridgectl bootstrap,绝不进对话。",
  "display_information": {
    "name": "slack-bridge",
    "description": "Bind a local Claude Code session to a Slack channel or DM (build-in-public bridge).",
    "background_color": "#1f2933"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "cc",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "chat:write",
        "reactions:write",
        "files:read",
        "files:write",
        "users:read",
        "users:read.email",
        "metadata.message:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
